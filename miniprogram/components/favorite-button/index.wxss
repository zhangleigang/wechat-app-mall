/* components/favorite-button/index.wxss */

.favorite-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.favorite-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.favorite-icon .icon {
  font-size: 24px;
  color: #999;
  transition: all 0.3s ease;
}

/* 已收藏状态 */
.favorite-icon.favorited .icon {
  color: #FFD700;
  text-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
}

/* 动画效果 */
.favorite-icon.animating {
  animation: favorite-bounce 0.3s ease;
}

@keyframes favorite-bounce {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.3) rotate(15deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}

/* 加载状态 */
.favorite-icon.loading {
  opacity: 0.6;
  pointer-events: none;
}

.favorite-icon.loading .icon {
  animation: favorite-pulse 1s ease infinite;
}

@keyframes favorite-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* 尺寸变体 */
.favorite-button.small .favorite-icon .icon {
  font-size: 18px;
}

.favorite-button.medium .favorite-icon .icon {
  font-size: 24px;
}

.favorite-button.large .favorite-icon .icon {
  font-size: 32px;
}

/* 悬停效果（仅在支持的平台） */
.favorite-icon:active {
  transform: scale(0.95);
}

/* 未收藏状态悬停 */
.favorite-icon:not(.favorited):active .icon {
  color: #FFD700;
}
