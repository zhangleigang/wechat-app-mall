/* components/favorite-button/index.wxss */

.favorite-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  margin-left: 16rpx;
}

.favorite-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.favorite-icon:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.favorite-icon .icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  transition: all 0.3s ease;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 已收藏状态 */
.favorite-icon.favorited {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-color: #FFD700;
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.4);
}

.favorite-icon.favorited .icon {
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 动画效果 */
.favorite-icon.animating {
  animation: favorite-bounce 0.3s ease;
}

@keyframes favorite-bounce {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.2) rotate(15deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}

/* 加载状态 */
.favorite-icon.loading {
  opacity: 0.6;
  pointer-events: none;
}

.favorite-icon.loading .icon {
  animation: favorite-pulse 1s ease infinite;
}

@keyframes favorite-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* 尺寸变体 */
.favorite-button.small .favorite-icon {
  padding: 10rpx;
}

.favorite-button.small .favorite-icon .icon {
  font-size: 28rpx;
}

.favorite-button.medium .favorite-icon {
  padding: 12rpx;
}

.favorite-button.medium .favorite-icon .icon {
  font-size: 32rpx;
}

.favorite-button.large .favorite-icon {
  padding: 14rpx;
}

.favorite-button.large .favorite-icon .icon {
  font-size: 36rpx;
}

/* 未收藏状态悬停效果 */
.favorite-icon:not(.favorited):active {
  background: rgba(255, 215, 0, 0.3);
  border-color: rgba(255, 215, 0, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.2);
}

.favorite-icon:not(.favorited):active .icon {
  color: #FFD700;
}
