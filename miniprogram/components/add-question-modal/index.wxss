/* components/add-question-modal/index.wxss */
.modal-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f5f5f5;
}

/* 头部 */
.modal-header {
  padding: 40rpx 30rpx 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
}

/* 头部装饰效果 */
.modal-header::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 0;
  width: 100%;
  height: 40rpx;
  background: linear-gradient(to bottom, rgba(102, 126, 234, 0.1), #f5f5f5);
  pointer-events: none;
}

.modal-title {
  font-size: 38rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
  text-align: center;
}

.modal-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
  line-height: 1.5;
  text-align: center;
}

/* 内容区域 */
.modal-content {
  flex: 1;
  padding: 30rpx 0rpx 30rpx;
  overflow-y: auto;
  min-height: 0; /* 防止flex子元素溢出 */
  width: 100%;
  /* 隐藏滚动条并确保内容占据整个宽度 */
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE 和 Edge */
}

/* 隐藏微信小程序滚动条 */
.modal-content::-webkit-scrollbar {
  display: none;
}

/* 确保所有容器占据整个宽度 */
.modal-container {
  width: 100%;
  box-sizing: border-box;
}

/* 确保van-popup内容占据整个宽度 */
.van-popup__content {
  width: 100% !important;
  padding: 0 !important;
}

/* 移除可能的默认内边距 */
.van-popup {
  padding: 0 !important;
}

/* 区块 */
.section {
  margin: 0 30rpx 30rpx;
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.section:hover {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.title-required {
  color: #ee0a24;
  margin-left: 4rpx;
  font-size: 28rpx;
}

.title-tip {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.title-badge {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
}

.title-badge.success {
  color: #07c160;
  background: #e8f5e9;
}

/* 问题输入 */
.question-input {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
  transition: all 0.3s ease;
  border: 2rpx solid #e0e0e0;
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 120rpx;
}

.question-input:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
  background: #fff;
  outline: none;
}

/* 标签输入容器 */
.tag-input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  transition: all 0.3s ease;
  border: 2rpx solid #e0e0e0;
}

.tag-input-container:focus-within {
  border-color: #667eea;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.1);
  background: #fff;
}

/* 标签输入框 */
.tag-input {
  flex: 1;
  background: transparent;
  border: none;
  font-size: 26rpx;
  outline: none;
}

/* 输入框占位符样式 */
.question-input::placeholder,
.tag-input::placeholder {
  color: #999;
  opacity: 0.8;
}

/* 字符计数样式 */
.van-field__word-limit {
  color: #999;
  font-size: 22rpx;
  margin-top: 8rpx;
  text-align: right;
}

/* 错误提示 */
.error-text {
  font-size: 24rpx;
  color: #ee0a24;
  margin-top: 12rpx;
  padding-left: 20rpx;
}

/* 生成中状态 */
.generating-container {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
}

.generating-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.generating-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.progress-bar {
  margin-top: 20rpx;
}

/* 自定义主题按钮 */
.primary-button {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  border: none !important;
  color: #fff !important;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  width: 100%;
  margin-top: 10rpx;
}

/* 按钮悬停效果 */
.primary-button:hover {
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.4);
}

/* 按钮点击效果 */
.primary-button:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

/* 按钮禁用状态 */
.primary-button:disabled {
  background: #e0e0e0 !important;
  box-shadow: none !important;
  opacity: 0.6;
  transform: none;
}

/* 答案预览 */
.answer-preview {
  background: #fafafa;
  border-radius: 12rpx;
  padding: 5rpx;
  max-height: 400rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  border: 2rpx solid #e0e0e0;
}

.answer-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.regenerate-btn {
  margin-top: 20rpx;
}

/* 标签管理 */
.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag-item {
  display: inline-block;
}

.tag-input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  transition: all 0.3s ease;
  border: 2rpx solid #e0e0e0;
}

/* 统一所有按钮的圆角 */
.van-button {
  border-radius: 12rpx !important;
}

/* 统一标签样式 */
.van-tag {
  border-radius: 12rpx !important;
  font-size: 24rpx !important;
  padding: 6rpx 16rpx !important;
  margin-right: 12rpx !important;
  margin-bottom: 12rpx !important;
}

/* 统一错误提示样式 */
.error-text {
  font-size: 24rpx;
  color: #ee0a24;
  margin-top: 12rpx;
  background: #fff5f5;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #ee0a24;
  box-sizing: border-box;
}

/* 统一标题徽章样式 */
.title-badge {
  font-size: 22rpx;
  color: #999;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background: #f0f0f0;
  border-radius: 16rpx;
}

.tag-input {
  flex: 1;
}

/* 底部操作栏 */
.modal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  border-top: 1rpx solid #e0e0e0;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
  box-sizing: border-box;
  width: 100%;
}

/* 按钮容器 */
.footer-btn-container {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

/* 按钮基础样式 */
.footer-btn {
  flex: 1;
  font-weight: 500;
  transition: all 0.3s ease;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 主要按钮样式 */
.footer-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
}

/* 默认按钮样式 */
.footer-btn.default {
  background: #fff;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

/* 按钮点击效果 */
.footer-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 按钮禁用状态 */
.footer-btn:disabled {
  opacity: 0.6;
  transform: none;
}

/* 加载动画增强 */
.generating-container {
  position: relative;
  overflow: hidden;
}

.generating-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* 答案预览加载动画 */
.answer-preview {
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 进度条动画 */
.progress-bar {
  transition: all 0.3s ease-out;
}
