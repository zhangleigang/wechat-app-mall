<view class="page-container">
  <!-- 未登录状态 -->
  <view wx:if="{{ !userInfo }}" class="login-container">
    <view class="gradient-header">
      <text class="text-3xl text-bold text-white mb-sm">个人中心</text>
      <text class="text-sm text-white" style="opacity: 0.9;">登录后查看更多功能</text>
    </view>
    
    <view class="login-card">
      <text class="login-icon">👤</text>
      <text class="login-title">欢迎使用 AI 面试助手</text>
      <text class="login-desc">登录后可使用更多功能</text>
      <button class="btn btn-primary btn-block btn-lg mt-xl" bindtap="login">
        立即登录
      </button>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view wx:else>
    <!-- 用户信息头部 -->
    <view class="gradient-header">
      <view class="user-header">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image 
            class="user-avatar" 
            src="{{ (userInfo && userInfo.avatarUrl) ? userInfo.avatarUrl : '/images/default.png' }}" 
            mode="aspectFill"
            binderror="onAvatarError"
          />
          <view class="avatar-edit-tip">点击更换</view>
        </button>
        
        <view class="user-info">
          <view class="user-nick" bindtap="editNickname">
            <text class="nick-text">{{ nick || (userInfo && userInfo.nickName) || '用户' }}</text>
            <text class="edit-icon">✏️</text>
          </view>
          
          <view class="user-id">
            <text class="id-label">ID: {{ shortId || '--' }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 会员信息卡片 -->
    <view class="member-card">
      <view class="member-header">
        <view class="member-title">
          <text class="member-icon">💎</text>
          <text class="member-text">会员服务</text>
        </view>
        <view class="member-status {{ memberInfo && memberInfo.isValid ? 'active' : 'inactive' }}">
          {{ memberInfo && memberInfo.isValid ? '已开通' : '未开通' }}
        </view>
      </view>
      
      <view class="member-body">
        <!-- 已开通会员 -->
        <view wx:if="{{ memberInfo && memberInfo.isValid }}" class="member-info-grid">
          <view class="member-info">
            <text class="info-label">有效期至</text>
            <text class="info-value">{{ memberExpireDate || '--' }}</text>
          </view>
          <view class="member-info">
            <text class="info-label">剩余天数</text>
            <text class="info-value">{{ memberDaysRemaining }}天</text>
          </view>
          <view class="member-actions">
            <button class="btn-text" bindtap="refreshMemberInfo">刷新状态</button>
          </view>
        </view>
        
        <!-- 未开通会员 -->
        <view wx:else class="member-empty">
          <text class="empty-text">体验完整功能</text>
          <text class="empty-desc">联系我的微信，开始体验AI面试助手的完整功能</text>
          <button class="btn btn-primary" bindtap="goMemberPayment">联系微信体验</button>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-section">
      <!-- 会员权益按钮暂时隐藏 -->
      <view wx:if="{{false}}" class="menu-item-card" bindtap="goMemberBenefits">
        <view class="menu-item-left">
          <text class="menu-icon">💎</text>
          <text class="menu-title">会员权益</text>
        </view>
        <text class="menu-arrow">→</text>
      </view>
      
      <!-- 管理员功能 - 仅管理员可见 -->
      <view wx:if="{{isAdmin}}" class="menu-item-card" bindtap="goUserManage">
        <view class="menu-item-left">
          <text class="menu-icon">👥</text>
          <text class="menu-title">用户管理</text>
        </view>
        <text class="menu-arrow">→</text>
      </view>
      
      <view wx:if="{{isAdmin}}" class="menu-item-card" bindtap="goOrderManage">
        <view class="menu-item-left">
          <text class="menu-icon">📋</text>
          <text class="menu-title">订单管理</text>
          <text class="menu-badge" wx:if="{{pendingOrderCount > 0}}">{{pendingOrderCount}}</text>
        </view>
        <text class="menu-arrow">→</text>
      </view>
      
      <view wx:if="{{isAdmin}}" class="menu-item-card" bindtap="goFeedbackManage">
        <view class="menu-item-left">
          <text class="menu-icon">💬</text>
          <text class="menu-title">反馈管理</text>
        </view>
        <text class="menu-arrow">→</text>
      </view>
      
      <view class="menu-item-card" bindtap="goSettings">
        <view class="menu-item-left">
          <text class="menu-icon">⚙️</text>
          <text class="menu-title">设置</text>
        </view>
        <text class="menu-arrow">→</text>
      </view>
      
      <view class="menu-item-card" bindtap="goFeedback">
        <view class="menu-item-left">
          <text class="menu-icon">💬</text>
          <text class="menu-title">意见反馈</text>
        </view>
        <text class="menu-arrow">→</text>
      </view>
      
      <view class="menu-item-card" bindtap="viewOpenId">
        <view class="menu-item-left">
          <text class="menu-icon">🔑</text>
          <text class="menu-title">查看OpenID</text>
        </view>
        <text class="menu-arrow">→</text>
      </view>
    </view>
  </view>
</view>