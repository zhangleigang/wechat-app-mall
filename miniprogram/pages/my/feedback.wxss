/* 反馈方式选择 */
.feedback-methods {
  padding: 32rpx;
  background: white;
  margin-bottom: 20rpx;
}

.method-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.method-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.method-item.active {
  background: #eff6ff;
  border-color: #3b82f6;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.1);
}

.method-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.method-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.method-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.method-desc {
  font-size: 24rpx;
  color: #6b7280;
}

/* 表单反馈 */
.form-feedback {
  background: white;
  padding: 32rpx;
}

.form-tip {
  margin: 24rpx 0;
  padding: 20rpx;
  background: #fef3c7;
  border-radius: 12rpx;
  border-left: 6rpx solid #f59e0b;
}

.form-tip text {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

/* 联系方式 */
.contact-method {
  padding: 32rpx;
  background: white;
}

.contact-card {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  margin-bottom: 32rpx;
}

.contact-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contact-title {
  font-size: 32rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 12rpx;
}

.contact-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.contact-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #fbbf24;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.contact-steps {
  background: #f8fafc;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.steps-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.step-item {
  display: block;
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
  padding-left: 20rpx;
  line-height: 1.4;
}

.step-item:last-child {
  margin-bottom: 0;
}

/* 按钮 */
.btn {
  margin-top: 32rpx;
  padding: 0 32rpx;
}