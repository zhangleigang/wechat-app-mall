<!-- 反馈方式选择 -->
<view class="feedback-methods">
  <view class="method-title">选择反馈方式</view>
  <view class="method-list">
    <view 
      wx:for="{{feedbackMethods}}" 
      wx:key="id"
      class="method-item {{selectedMethod === item.id ? 'active' : ''}}"
      data-method="{{item.id}}"
      bindtap="selectFeedbackMethod"
    >
      <text class="method-icon">{{item.icon}}</text>
      <view class="method-info">
        <text class="method-name">{{item.name}}</text>
        <text class="method-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 表单反馈 -->
<view wx:if="{{selectedMethod === 'form'}}" class="form-feedback">
  <block wx:if="{{feedbackCount >= maxFeedbackPerDay}}">
    <van-empty image="error" description="今天反馈次数已达上限，请明天再试或选择其他联系方式" />
  </block>
  <block wx:else>
    <van-field
      label="姓名"
      model:value="{{ name }}"
      placeholder="如何称呼您"
      clearable
    />
    <van-field
      label="联系方式"
      model:value="{{ mobile }}"
      placeholder="手机号或微信号（可选）"
      clearable
    />
    <van-field
      model:value="{{ content }}"
      placeholder="请详细描述您的问题或建议，我们会认真处理～"
      type="textarea"
      autosize="{{ autosize }}"
    />
    <view class="form-tip">
      <text>💡 提示：表单提交后我们会尽快处理，如需紧急联系请选择微信方式</text>
    </view>
    <view class="block-btn btn">
      <van-button type="primary" block bind:click="bindSave">提交反馈</van-button>
    </view>
  </block>
</view>

<!-- 微信联系 -->
<view wx:if="{{selectedMethod === 'wechat'}}" class="contact-method">
  <view class="contact-card">
    <view class="contact-icon">💬</view>
    <view class="contact-info">
      <text class="contact-title">微信直接沟通</text>
      <text class="contact-desc">添加微信好友，实时交流问题和建议</text>
      <text class="contact-value">微信号：{{contactInfo.wechat}}</text>
    </view>
  </view>
  <view class="contact-steps">
    <text class="steps-title">联系步骤：</text>
    <text class="step-item">1. 点击下方按钮复制微信号</text>
    <text class="step-item">2. 打开微信，搜索并添加好友</text>
    <text class="step-item">3. 发送消息说明来意</text>
  </view>
  <view class="block-btn btn">
    <van-button type="primary" block bind:click="contactWechat">复制微信号</van-button>
  </view>
</view>

<!-- 邮件反馈 -->
<view wx:if="{{selectedMethod === 'email'}}" class="contact-method">
  <view class="contact-card">
    <view class="contact-icon">📧</view>
    <view class="contact-info">
      <text class="contact-title">邮件详细反馈</text>
      <text class="contact-desc">发送邮件，可附带截图等详细信息</text>
      <text class="contact-value">邮箱：{{contactInfo.email}}</text>
    </view>
  </view>
  <view class="contact-steps">
    <text class="steps-title">发送邮件：</text>
    <text class="step-item">1. 点击下方按钮复制邮箱地址</text>
    <text class="step-item">2. 打开邮件应用，新建邮件</text>
    <text class="step-item">3. 详细描述问题，可附带截图</text>
  </view>
  <view class="block-btn btn">
    <van-button type="primary" block bind:click="contactEmail">复制邮箱地址</van-button>
  </view>
</view>