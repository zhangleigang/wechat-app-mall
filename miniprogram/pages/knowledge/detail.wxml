<view class="detail-page">
  <!-- 问题标题 -->
  <view class="question-section">
    <view class="question-header">
      <view class="question-icon">❓</view>
      <text class="question-title">{{question}}</text>
    </view>
    <view class="favorite-btn">
      <favorite-button
        question-id="{{currentItem.id}}"
        question="{{question}}"
        answer="{{answer}}"
        source-type="knowledge"
        source-category="{{currentItem.categoryName}}"
        is-favorited="{{isFavorite}}"
        favorite-id="{{favoriteId}}"
        size="large"
        bind:favoritechange="onFavoriteChange"
      />
    </view>
  </view>
  
  <!-- 答案内容 -->
  <view class="answer-section">
    <view class="answer-header">
      <text class="answer-icon">💡</text>
      <text class="answer-title">答案解析</text>
    </view>
    <view class="answer-content">
      <towxml nodes="{{answerHtml}}" selectable="{{true}}" />
    </view>
  </view>
</view>
