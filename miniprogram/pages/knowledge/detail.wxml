<view class="detail-page">
  <!-- 问题标题 -->
  <view class="question-section">
    <view class="question-header">
      <view class="question-icon">❓</view>
      <text class="question-title">{{question}}</text>
    </view>
    <view class="favorite-btn" bind:tap="toggleFavorite">
      <van-icon 
        name="{{isFavorite ? 'star' : 'star-o'}}" 
        size="24px" 
        color="{{isFavorite ? '#ff6b00' : '#999'}}"
      />
      <text class="favorite-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
  </view>
  
  <!-- 答案内容 -->
  <view class="answer-section">
    <view class="answer-header">
      <text class="answer-icon">💡</text>
      <text class="answer-title">答案解析</text>
    </view>
    <view class="answer-content">
      <towxml nodes="{{answerHtml}}" selectable="{{true}}" />
    </view>
  </view>
</view>
