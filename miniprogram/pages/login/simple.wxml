<view class="login-container">
  <!-- 顶部装饰 -->
  <view class="login-header">
    <view class="header-decoration"></view>
  </view>
  
  <!-- Logo和标题 -->
  <view class="login-brand">
    <view class="brand-icon">🎯</view>
    <text class="brand-title">AI面试助手</text>
    <text class="brand-subtitle">智能陪伴，助力求职</text>
  </view>
  
  <!-- 登录卡片 -->
  <view class="login-card">
    <view class="card-title">
      <text class="title-text">欢迎使用</text>
      <text class="title-desc">选择登录方式继续使用</text>
    </view>
    
    <!-- 用户信息填写 -->
    <view class="user-profile-form">
      <view class="form-title">完善个人信息</view>
      
      <!-- 头像选择 -->
      <view class="form-item">
        <text class="form-label">头像</text>
        <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image 
            class="avatar-image" 
            src="{{avatarUrl || '/images/default.png'}}" 
            mode="aspectFill"
          ></image>
          <text class="avatar-tip">{{avatarUrl ? '点击更换' : '点击选择'}}</text>
        </button>
      </view>
      
      <!-- 昵称输入 -->
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input 
          class="nickname-input" 
          type="nickname" 
          placeholder="点击选择微信昵称" 
          value="{{nickname}}"
          bindinput="onNicknameInput"
          maxlength="20"
        />
        <text class="form-hint">💡 点击输入框可选择微信昵称</text>
      </view>
      
      <!-- 保存并登录按钮 -->
      <button 
        class="login-btn primary-btn"
        bindtap="handleSaveAndLogin"
        disabled="{{loading}}"
      >
        <text class="btn-icon">✨</text>
        <text class="btn-text">{{loading ? '登录中...' : '保存并登录'}}</text>
      </button>
    </view>
    
    <!-- 或者快速登录 -->
    <view class="divider">
      <text class="divider-text">或者</text>
    </view>
    
    <!-- 其他登录方式 -->
    <view class="login-buttons">
      <!-- 快速登录（静默登录） -->
      <button 
        class="login-btn secondary-btn"
        bindtap="handleQuickLogin"
        disabled="{{loading}}"
      >
        <text class="btn-icon">⚡</text>
        <text class="btn-text">{{loading ? '登录中...' : '快速登录（跳过）'}}</text>
      </button>
    </view>
    
    <!-- 协议 -->
    <view class="agreement-section">
      <view class="agreement-checkbox" bindtap="toggleAgreement">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}" class="check-icon">✓</text>
        </view>
        <text class="agreement-text">
          我已阅读并同意
          <text class="agreement-link" catchtap="showAgreement" data-type="user">《用户协议》</text>
          和
          <text class="agreement-link" catchtap="showAgreement" data-type="privacy">《隐私政策》</text>
        </text>
      </view>
    </view>
  </view>
  
  <!-- 底部提示 -->
  <view class="login-footer">
    <text class="footer-text">登录即表示您同意我们的服务条款</text>
    <text class="footer-hint">本系统使用本地认证，数据安全可靠</text>
  </view>
</view>
