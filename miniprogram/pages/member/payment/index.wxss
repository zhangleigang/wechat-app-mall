/* pages/member/payment/index.wxss */
.payment-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #f5f5f5 30%);
  padding-bottom: 200rpx;
}

/* 支付金额卡片 */
.amount-card {
  margin: 40rpx 30rpx;
  padding: 50rpx 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  text-align: center;
}

.amount-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.amount-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 20rpx;
}

.currency {
  font-size: 48rpx;
  color: #ff6b00;
  font-weight: 600;
  margin-right: 10rpx;
}

.price {
  font-size: 80rpx;
  color: #ff6b00;
  font-weight: 700;
  line-height: 1;
}

.package-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx 30rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.step-item.active .step-number {
  background: #1989fa;
  color: #fff;
  transform: scale(1.1);
}

.step-text {
  font-size: 24rpx;
  color: #999;
}

.step-item.active .step-text {
  color: #1989fa;
  font-weight: 600;
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background: #e0e0e0;
  margin: 0 10rpx;
  margin-bottom: 30rpx;
}

/* 二维码区域 */
.qrcode-main {
  margin: 0 30rpx;
}

.qrcode-wrapper {
  position: relative;
  width: 100%;
  padding: 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  margin-bottom: 30rpx;
  border: 4rpx dashed #1989fa;
  box-sizing: border-box;
}

.qrcode-img {
  width: 100%;
  height: 550rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.qrcode-mask {
  position: absolute;
  top: 40rpx;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.qrcode-wrapper:active .qrcode-mask {
  opacity: 1;
}

.mask-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.mask-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 快速操作按钮 */
.quick-action {
  margin-bottom: 40rpx;
}

/* 简化说明 */
.simple-guide {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.guide-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.guide-item:last-child {
  border-bottom: none;
}

.guide-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.guide-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}



/* 底部操作区 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.help-text {
  text-align: center;
  padding: 20rpx 0 10rpx;
  font-size: 26rpx;
  color: #999;
}

.help-text .link {
  color: #1989fa;
  margin-left: 10rpx;
}
