/* pages/admin/users/index.wxss */
.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 250rpx;
}

/* 统计卡片 */
.stats-section {
  padding: 30rpx;
}

.stats-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 20rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.stat-value.member {
  color: #90ee90;
}

.stat-value.non-member {
  color: #ffd700;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 搜索栏 */
.search-section {
  padding: 0 30rpx 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-input::placeholder {
  color: #999;
}

/* 筛选标签 */
.filter-section {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 20rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  background: #fff;
  transition: all 0.3s;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.filter-tab.active {
  background: #1989fa;
  color: #fff;
  font-weight: 600;
}

/* 用户列表 */
.users-section {
  padding: 0 30rpx;
}

.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  border-left: 6rpx solid #1989fa;
}

/* 用户头部 */
.user-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.user-details {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.user-openid {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666;
  font-family: 'Courier New', monospace;
}

.user-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.user-status.member {
  background: #e8f5e9;
  color: #07c160;
}

.user-status.non-member {
  background: #fff7e6;
  color: #ff6b00;
}

/* 用户信息 */
.user-body {
  margin-bottom: 20rpx;
}

.user-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.user-row .label {
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}

.user-row .value {
  color: #333;
  flex: 1;
  word-break: break-all;
}

/* 操作按钮 */
.user-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  align-items: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 30rpx;
  color: #999;
  font-size: 28rpx;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-row van-button {
  flex: 1;
}

/* 刷新提示 */
.refresh-hint {
  margin-top: 20rpx;
  text-align: center;
}

.refresh-hint text {
  font-size: 24rpx;
  color: #999;
}