/* pages/admin/orders/index.wxss */
.admin-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 250rpx;
}

/* 统计卡片 */
.stats-section {
  padding: 30rpx;
}

.stats-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 20rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.stat-value.pending {
  color: #ffd700;
}

.stat-value.verified {
  color: #90ee90;
}

.stat-value.cancelled {
  color: #ff6b6b;
}

.stat-value.amount {
  font-size: 40rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 筛选标签 */
.filter-section {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.3s;
}

.filter-tab.active {
  background: #1989fa;
  color: #fff;
  font-weight: 600;
}

/* 订单列表 */
.orders-section {
  padding: 0 30rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  border-left: 6rpx solid #ff6b00;
}

.order-card.verified {
  border-left-color: #07c160;
  opacity: 0.7;
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-number {
  display: flex;
  align-items: center;
  gap: 15rpx;
  font-size: 26rpx;
  color: #1989fa;
  font-family: 'Courier New', monospace;
}

.order-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.order-status.pending_verify {
  background: #fff7e6;
  color: #ff6b00;
}

.order-status.verified {
  background: #e8f5e9;
  color: #07c160;
}

.order-status.cancelled {
  background: #ffeaea;
  color: #f56c6c;
}

/* 订单信息 */
.order-body {
  margin-bottom: 20rpx;
}

.order-row {
  display: flex;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.order-row .label {
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.order-row .value {
  color: #333;
  flex: 1;
  word-break: break-all;
}

.order-row .value.price {
  color: #ff6b00;
  font-weight: 600;
  font-size: 32rpx;
}

/* 操作按钮 */
.order-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  align-items: center;
}

/* 已核实订单的操作区域样式 */
.order-card.verified .order-actions {
  opacity: 0.6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-row van-button {
  flex: 1;
}
/* 刷新提示 */
.refresh-hint {
  margin-top: 20rpx;
  text-align: center;
}

.refresh-hint text {
  font-size: 24rpx;
  color: #999;
}

/* 加载状态 */
.loading-more {
  padding: 30rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}