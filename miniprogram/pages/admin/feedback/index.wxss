/* 反馈管理页面样式 */
.feedback-admin {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 筛选器 */
.filter-bar {
  margin: 0 20rpx 20rpx;
}

/* 反馈列表 */
.feedback-list {
  padding: 0 20rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
  color: #6b7280;
}

.empty {
  padding: 80rpx;
}

/* 反馈项 */
.feedback-item {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  border-left: 8rpx solid #e5e7eb;
}

.feedback-item.unread {
  border-left-color: #ef4444;
}

.feedback-item.read {
  border-left-color: #f59e0b;
}

.feedback-item.resolved {
  border-left-color: #10b981;
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.time {
  font-size: 24rpx;
  color: #6b7280;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-badge.unread {
  background: #fef2f2;
  color: #dc2626;
}

.status-badge.read {
  background: #fffbeb;
  color: #d97706;
}

.status-badge.resolved {
  background: #f0fdf4;
  color: #16a34a;
}

/* 内容 */
.content {
  margin-bottom: 24rpx;
}

.content-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

/* 联系方式 */
.contact-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.contact-item {
  font-size: 24rpx;
  color: #3b82f6;
  background: #eff6ff;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 16rpx;
}