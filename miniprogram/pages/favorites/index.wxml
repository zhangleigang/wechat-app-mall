<view class="favorites-container">
  <!-- 渐变头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <text class="header-title">我的收藏</text>
      <text class="header-subtitle" wx:if="{{!activeTag}}">{{total}} 个收藏</text>
      <text class="header-subtitle" wx:else>标签"{{activeTag}}"：{{total}} 个收藏</text>
    </view>
    
    <!-- 配额信息 -->
    <view class="quota-info" wx:if="{{isLogined}}">
      <text class="quota-text" wx:if="{{quotaInfo.unlimited}}">
        <view class="vip-badge">
          <text class="vip-icon">✨</text>
          <text class="vip-text">会员无限制</text>
        </view>
      </text>
      <text class="quota-text" wx:else>
        {{quotaInfo.current}}/{{quotaInfo.limit}} 
        <text class="quota-remaining" wx:if="{{quotaInfo.remaining > 0}}">
          (剩余{{quotaInfo.remaining}}个)
        </text>
        <text class="quota-full" wx:else>
          (已达上限)
        </text>
      </text>
    </view>
  </view>

  <!-- 标签筛选区 -->
  <view class="tags-filter" wx:if="{{allTags.length > 0 && !isEmpty}}">
    <scroll-view class="tags-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tags-container">
        <!-- 全部标签 -->
        <view 
          class="tag-item {{activeTag === null ? 'active' : ''}}"
          bindtap="clearTagFilter"
        >
          <text class="tag-text">全部</text>
          <text class="tag-count">{{total}}</text>
        </view>

        <!-- 其他标签 -->
        <view 
          wx:for="{{allTags}}"
          wx:key="id"
          class="tag-item {{activeTag === item.name ? 'active' : ''}}"
          bindtap="selectTag"
          data-tag="{{item.name}}"
        >
          <text class="tag-text">{{item.name}}</text>
          <text class="tag-count">{{item.useCount}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 加载中 - 骨架屏 -->
  <view class="skeleton-container" wx:if="{{loading}}">
    <view class="skeleton-item" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
      <view class="skeleton-question"></view>
      <view class="skeleton-tags">
        <view class="skeleton-tag"></view>
        <view class="skeleton-tag"></view>
      </view>
      <view class="skeleton-footer">
        <view class="skeleton-source"></view>
        <view class="skeleton-time"></view>
      </view>
    </view>
  </view>

  <!-- 收藏列表 -->
  <view class="favorites-list" wx:if="{{!loading && !isEmpty}}">
    <view 
      class="favorite-item"
      wx:for="{{favorites}}"
      wx:key="id"
      bindtap="viewDetail"
      data-id="{{item.id}}"
    >
      <!-- 问题预览 -->
      <view class="item-question">
        <text class="question-text">{{item.questionPreview}}</text>
      </view>

      <!-- 标签列表 -->
      <view class="item-tags" wx:if="{{item.tags && item.tags.length > 0}}">
        <view 
          wx:for="{{item.tags}}"
          wx:for-item="tag"
          wx:key="id"
          class="tag-badge"
        >
          {{tag.name}}
        </view>
        <view wx:if="{{item.tags.length > 5}}" class="tag-more">
          +{{item.tags.length - 5}}
        </view>
      </view>

      <!-- 底部信息 -->
      <view class="item-footer">
        <view class="source-info">
          <text class="source-icon">{{item.sourceIcon}}</text>
          <text class="source-name">{{item.sourceName}}</text>
          <text wx:if="{{item.sourceCategory}}" class="source-category">
            · {{item.sourceCategory}}
          </text>
        </view>
        <text class="item-time">{{item.formattedTime}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <van-loading wx:if="{{loadingMore}}" size="20px">加载中...</van-loading>
      <text wx:else class="load-more-text">上拉加载更多</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && favorites.length > 0}}">
      <text class="no-more-text">没有更多了</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && isEmpty}}">
    <van-icon name="star-o" size="80px" color="#ccc" />
    <text class="empty-text" wx:if="{{!isLogined}}">请先登录</text>
    <text class="empty-text" wx:elif="{{activeTag}}">该标签下暂无收藏</text>
    <text class="empty-text" wx:else>暂无收藏</text>
    
    <text class="empty-tip" wx:if="{{isLogined && !activeTag}}">
      在知识库或简历解读中点击收藏按钮即可添加
    </text>
    <text class="empty-tip" wx:if="{{isLogined && activeTag}}">
      试试其他标签或清除筛选查看全部收藏
    </text>
    
    <van-button 
      type="primary" 
      size="small"
      round
      bindtap="goLogin"
      wx:if="{{!isLogined}}"
      custom-class="login-btn"
    >
      去登录
    </van-button>
    
    <van-button 
      type="default" 
      size="small"
      round
      bindtap="clearTagFilter"
      wx:if="{{isLogined && activeTag}}"
      custom-class="clear-filter-btn"
    >
      清除筛选
    </van-button>
  </view>

  <!-- 添加自定义问题按钮（悬浮） -->
  <view class="add-question-fab" wx:if="{{isLogined}}" bindtap="showAddQuestionModal">
    <van-icon name="plus" size="24px" color="#fff" />
  </view>

  <!-- 添加问题弹窗 -->
  <add-question-modal
    show="{{showAddModal}}"
    openid="{{openid}}"
    quotaInfo="{{quotaInfo}}"
    bind:close="closeAddQuestionModal"
    bind:saved="onQuestionSaved"
    bind:quotaExceeded="onQuotaExceeded"
  />
</view>
