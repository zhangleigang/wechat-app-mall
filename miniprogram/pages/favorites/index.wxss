/* pages/favorites/index.wxss */
.favorites-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 渐变头部 */
.gradient-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 30rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header-content {
  flex: 1;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
}

/* 配额信息 */
.quota-info {
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10rpx);
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
}

.quota-info:hover {
  background: rgba(255, 255, 255, 0.25);
}

.quota-text {
  font-size: 24rpx;
  color: #fff;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

/* VIP徽章样式 */
.vip-badge {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffd700, #ffed4e);
  padding: 4rpx 12rpx;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.3);
  animation: vipShine 2s ease-in-out infinite;
}

@keyframes vipShine {
  0%, 100% {
    box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.3);
  }
  50% {
    box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.5);
  }
}

.vip-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
  animation: rotate 4s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.vip-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #8b4513;
}

.quota-remaining {
  opacity: 0.9;
}

.quota-full {
  color: #ffeb3b;
  font-weight: bold;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.8;
  }
}

/* 标签筛选区 */
.tags-filter {
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tags-scroll {
  white-space: nowrap;
}

.tags-container {
  display: inline-flex;
  padding: 0 30rpx;
  gap: 20rpx;
}

.tag-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tag-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
  transform: translateY(-2rpx);
}

.tag-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.tag-item.active .tag-text {
  color: #fff;
  font-weight: 600;
}

.tag-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
  background: rgba(0, 0, 0, 0.08);
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
}

.tag-item.active .tag-count {
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

/* 收藏列表 */
.favorites-list {
  padding: 20rpx 30rpx;
}

.favorite-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.favorite-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 问题预览 */
.item-question {
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 标签列表 */
.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag-badge {
  padding: 6rpx 16rpx;
  background: #e3f2fd;
  color: #1976d2;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.tag-more {
  padding: 6rpx 16rpx;
  background: #f5f5f5;
  color: #999;
  font-size: 22rpx;
  border-radius: 20rpx;
}

/* 底部信息 */
.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.source-info {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.source-icon {
  margin-right: 8rpx;
}

.source-name {
  color: #666;
}

.source-category {
  color: #999;
  margin-left: 4rpx;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 没有更多 */
.no-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  font-weight: 500;
  margin-top: 30rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #ccc;
  margin-top: 20rpx;
  text-align: center;
  line-height: 1.6;
}

.login-btn {
  margin-top: 40rpx;
}

.clear-filter-btn {
  margin-top: 40rpx;
}

/* 添加问题悬浮按钮 */
.add-question-fab {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: all 0.3s;
}

.add-question-fab:active {
  transform: scale(0.9);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 骨架屏样式 */
.skeleton-container {
  padding: 20rpx 30rpx;
}

.skeleton-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.skeleton-question {
  height: 80rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.skeleton-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.skeleton-tag {
  width: 120rpx;
  height: 40rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 20rpx;
}

.skeleton-footer {
  display: flex;
  justify-content: space-between;
}

.skeleton-source {
  width: 200rpx;
  height: 32rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

.skeleton-time {
  width: 120rpx;
  height: 32rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
