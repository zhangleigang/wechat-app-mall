<view class="page-container">
  <!-- 页面头部 -->
  <view class="gradient-header">
    <view class="header-content">
      <view class="header-text">
        <text class="text-2xl text-bold text-white">简历解读</text>
        <text class="text-sm text-white mt-xs" style="opacity: 0.9;">
          AI智能分析简历，提供优化建议
        </text>
      </view>
    </view>
  </view>
  
  <!-- 简历列表区域 -->
  <view class="resume-list-section">
    <!-- 上传引导（无简历时显示） -->
    <view wx:if="{{resumeList.length === 0}}" class="upload-guide">
      <view class="upload-icon">📄</view>
      <text class="upload-title">上传简历开始分析</text>
      <text class="upload-desc">支持 PDF、Word、Markdown 格式</text>
      <button class="upload-btn" bindtap="uploadResume">
        <text class="upload-btn-text">选择文件</text>
      </button>
    </view>
    
    <!-- 简历卡片列表（有简历时显示） -->
    <view wx:else class="resume-cards-container">
      <view class="resume-cards-header">
        <text class="cards-title">我的简历 ({{resumeList.length}}/3)</text>
        <button 
          wx:if="{{resumeList.length < 3}}" 
          class="add-resume-btn" 
          bindtap="uploadResume"
        >
          <text class="add-icon">➕</text>
          <text class="add-text">添加</text>
        </button>
      </view>
      
      <scroll-view class="resume-cards-scroll" scroll-x="true" show-scrollbar="false">
        <view class="resume-cards-list">
          <view 
            wx:for="{{resumeList}}" 
            wx:key="id"
            class="resume-card {{activeResumeId === item.id ? 'active' : ''}}"
            bindtap="onResumeCardTap"
            bindlongpress="onResumeCardLongPress"
            data-id="{{item.id}}"
            data-name="{{item.filename}}"
          >
            <!-- 选中标识 -->
            <view wx:if="{{activeResumeId === item.id}}" class="card-badge">
              <text class="badge-text">当前</text>
            </view>
            
            <!-- 文件信息 -->
            <view class="card-info">
              <text class="card-filename">{{item.filename}}</text>
              <text class="card-time">{{item.uploadTime}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  
  <!-- 预设问题（仅在有activeResume时显示） -->
  <view wx:if="{{activeResumeId && messages.length === 0}}" class="preset-questions-section">
    <text class="preset-title">💡 快速分析</text>
    <scroll-view class="preset-scroll" scroll-x="true" show-scrollbar="false">
      <view class="preset-list">
        <view 
          wx:for="{{presetQuestions}}" 
          wx:key="index"
          class="preset-item"
          bindtap="selectPresetQuestion"
          data-question="{{item}}"
        >
          <text class="preset-text">{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
  
  <!-- 对话区域 -->
  <scroll-view 
    class="chat-container" 
    scroll-y="true" 
    scroll-top="{{scrollTop}}" 
    scroll-with-animation="true"
    enhanced="true"
    show-scrollbar="false"
  >
    <view class="messages-wrapper">
      <!-- 空状态提示 -->
      <view wx:if="{{messages.length === 0 && activeResumeId}}" class="empty-chat-hint">
        <text class="empty-icon">💬</text>
        <text class="empty-text">选择上方预设问题，或输入您的问题开始分析</text>
      </view>
      
      <block wx:for="{{messages}}" wx:key="index">
        <view class="message-item {{item.role === 'user' ? 'user-message' : 'ai-message'}}">
          <!-- 用户消息 -->
          <view wx:if="{{item.role === 'user'}}" class="user-bubble">
            <view class="message-avatar user-avatar">
              <text class="avatar-text">我</text>
            </view>
            <view class="message-bubble user-bubble-content">
              <text class="message-text">{{item.content}}</text>
              <text class="message-time">{{item.time}}</text>
            </view>
          </view>
          
          <!-- AI消息 -->
          <view wx:else class="ai-bubble">
            <view class="message-avatar ai-avatar">
              <text class="avatar-text">AI</text>
            </view>
            <view class="message-bubble ai-bubble-content">
              <!-- 使用 towxml 渲染 Markdown -->
            <towxml 
              class="markdown-content"
              nodes="{{item.htmlContent}}"
              selectable="{{true}}"
            />
              <text class="message-time">{{item.time}}</text>
              
              <!-- 操作按钮 -->
              <view class="message-actions">
                <view class="action-btn" bindtap="copyMessage" data-content="{{item.content}}">
                  <text class="action-icon">📋</text>
                  <text class="action-text">复制</text>
                </view>
                <view class="action-btn" bindtap="likeMessage" data-index="{{index}}">
                  <text class="action-icon">👍</text>
                  <text class="action-text">有用</text>
                </view>
                <view class="action-btn favorite-action">
                  <favorite-button
                    question="{{item.question}}"
                    answer="{{item.content}}"
                    source-type="resume"
                    is-favorited="{{item.isFavorited}}"
                    favorite-id="{{item.favoriteId}}"
                    size="small"
                    bind:favoritechange="onFavoriteChange"
                    data-index="{{index}}"
                  />
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      
      <!-- AI正在回复的提示 -->
      <view wx:if="{{sending}}" class="message-item ai-message">
        <view class="ai-bubble">
          <view class="message-avatar ai-avatar">
            <text class="avatar-text">AI</text>
          </view>
          <view class="message-bubble ai-bubble-content typing-bubble">
            <view class="typing-indicator">
              <text class="typing-text">AI正在分析中</text>
              <view class="typing-dots">
                <view class="dot"></view>
                <view class="dot"></view>
                <view class="dot"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 底部占位 -->
      <view class="messages-bottom"></view>
    </view>
  </scroll-view>
  
  <!-- 输入区域 -->
  <view class="input-section">
    <!-- 功能按钮栏 -->
    <view wx:if="{{messages.length > 0}}" class="function-bar">
      <view class="function-btn" bindtap="clearChat">
        <text class="function-icon">🗑️</text>
        <text class="function-text">清空</text>
      </view>
      <view class="function-btn" bindtap="exportChat">
        <text class="function-icon">📤</text>
        <text class="function-text">导出</text>
      </view>
    </view>
    
    <!-- 输入框 -->
    <view class="input-container">
      <view class="input-wrapper">
        <textarea 
          class="message-input" 
          placeholder="输入问题开始分析..." 
          value="{{inputVal}}" 
          bindinput="handleInput"
          bindconfirm="send"
          auto-height
          maxlength="2000"
          show-confirm-bar="false"
        ></textarea>
        
        <!-- 字数统计 -->
        <view wx:if="{{inputVal.length > 0}}" class="char-count">
          <text class="count-text">{{inputVal.length}}/2000</text>
        </view>
      </view>
      
      <!-- 发送按钮 -->
      <view class="send-button-wrapper">
        <button 
          class="send-button {{inputVal && !sending ? 'active' : 'disabled'}}" 
          bindtap="send" 
          disabled="{{!inputVal || sending}}"
        >
          <text wx:if="{{sending}}" class="send-icon loading">⏳</text>
          <text wx:else class="send-icon">🚀</text>
        </button>
      </view>
    </view>
  </view>
</view>