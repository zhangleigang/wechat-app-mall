<view class="payment-container">
  <!-- 支付金额卡片 -->
  <view class="amount-card">
    <view class="amount-label">支付金额</view>
    <view class="amount-value">
      <text class="currency">¥</text>
      <text class="price">{{packageInfo.price}}</text>
    </view>
    <view class="package-name">{{packageInfo.name}}</view>
  </view>

  <!-- 收款码区域 -->
  <view class="qrcode-main">
    <!-- 步骤指示 -->
    <view class="step-indicator">
      <view class="step-item active">
        <view class="step-number">1</view>
        <view class="step-text">长按保存</view>
      </view>
      <view class="step-line"></view>
      <view class="step-item">
        <view class="step-number">2</view>
        <view class="step-text">扫码支付</view>
      </view>
      <view class="step-line"></view>
      <view class="step-item">
        <view class="step-number">3</view>
        <view class="step-text">确认开通</view>
      </view>
    </view>

    <!-- 二维码 -->
    <view class="qrcode-wrapper">
      <image 
        class="qrcode-img" 
        src="{{localQrcodeUrl || qrcodeUrl}}" 
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
        bind:longpress="quickSave"
      />
      <view class="qrcode-mask" bind:tap="quickSave">
        <view class="mask-content">
          <van-icon name="photo-o" size="48px" color="#fff" />
          <text class="mask-text">长按保存二维码</text>
        </view>
      </view>
    </view>

    <!-- 快速操作按钮 -->
    <view class="quick-action">
      <van-button 
        type="primary" 
        size="large"
        block
        round
        icon="photo-o"
        bind:click="quickSave"
      >
        点击保存收款码
      </van-button>
    </view>

    <!-- 简化说明 -->
    <view class="simple-guide">
      <view class="guide-item">
        <text class="guide-icon">📱</text>
        <text class="guide-text">保存后打开微信扫一扫</text>
      </view>
      <view class="guide-item">
        <text class="guide-icon">📷</text>
        <text class="guide-text">点击相册选择刚保存的图片</text>
      </view>
      <view class="guide-item">
        <text class="guide-icon">💰</text>
        <text class="guide-text">确认金额后完成支付</text>
      </view>
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="bottom-actions">
    <van-button 
      type="primary" 
      size="large" 
      block
      bind:click="handlePaid"
      loading="{{checking}}"
      disabled="{{checking}}"
    >
      ✓ 我已完成支付
    </van-button>
    
    <view class="help-text" bind:tap="showDetailGuide">
      <text>需要帮助？</text>
      <text class="link">查看详细步骤 ></text>
    </view>
  </view>
</view>
